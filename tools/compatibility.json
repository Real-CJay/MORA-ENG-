      "tests": ["offline"],
      "manual": "Cold offline startup and device update behavior remain manual acceptance checks."
    },
    "cs-intermediate": {
      "revision": 1,
      "paths": ["tools/cs_block_prompt_generator.py", "tools/cs_extraction_review.py", "tools/cs_extractor_to_preview_schema.py", "tools/pdf_image_extractor.py", "tools/requirements.txt", "tools/tests/test_cs_block_prompt_generator.py", "tools/cs_extraction_workflow.md"],
